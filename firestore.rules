rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if own(uid);
      allow create, update, delete: if false;
    }

    match /transactions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /withdrawals/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /tasks/{id} {
      allow read: if signedIn() && resource.data.status == 'active';
      allow write: if false;
    }

    match /referrals/{id} {
      allow read: if signedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid);
      allow write: if false;
    }

    match /appConfig/{id} {
      allow read: if signedIn() && id == 'public';
      allow write: if false;
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /rewardRequests/{id} {
      allow read, write: if false;
    }
  }
}
